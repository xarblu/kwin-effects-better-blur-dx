#: src/kcm/blur_config.cpp:72
#, no-c-format
msgid ""
"<p><strong>Exact match:</strong><br>By default window classes are matched "
"exactly.<br>Example: <code>org.kde.dolphin</code> matches only Dolphin.</p>"
msgstr ""

#: src/kcm/blur_config.cpp:76
#, no-c-format
msgid ""
"<p><strong>Regex match:</strong><br>If wrapped with <code>/</code> window "
"classes are matched by Perl compatible regular expression.<br>Example: "
"<code>/^org\\.kde\\..*/</code> matches all KDE applications.</p>"
msgstr ""

#: src/kcm/blur_config.cpp:80
#, no-c-format
msgid ""
"<p><strong>Empty match:</strong><br>Use the special value <code>$blank</"
"code> to match empty window classes.</p>"
